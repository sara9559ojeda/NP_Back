# Copia este archivo como .env (no se sube a Git) y escribe los valores tú.
# Usa solo letras, números, "-" y "_" en usuario y contraseña de la base: van dentro de una URL.

# PostgreSQL (docker compose)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Clave del servidor: firma los JWT y protege los códigos de emparejamiento. Mínimo 32 caracteres.
# Se puede generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
NP_SECRET_KEY=

# Origen de la web (CORS). Solo ese origen puede llamar a la API desde el navegador.
NP_CORS_ORIGIN=

# true salvo que pruebes la web por HTTP desde otra máquina que no sea localhost.
NP_COOKIE_SECURE=

# Nivel de log (INFO por defecto).
NP_LOG_LEVEL=

# Solo si ejecutas la API fuera de Docker (en Docker se compone sola con los valores de arriba):
# NP_DATABASE_URL=postgresql+psycopg://USUARIO:CONTRASEÑA@localhost:5433/BASE
