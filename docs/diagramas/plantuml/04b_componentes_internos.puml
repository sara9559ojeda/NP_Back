@startuml 04b_componentes_internos
title NEUROPHOBIA - Componentes internos de cada aplicación
skinparam classAttributeIconSize 0
skinparam linetype ortho
hide empty members

package "API NEUROPHOBIA (NP_Back)" <<subsystem>> {
  component "Routers HTTP" as Routers_HTTP <<component>>
  note bottom of Routers_HTTP
    api/routes: auth, me, patients,
    admin, device, public, health
  end note
  component "Autenticación y permisos" as Autenticación_y_permisos <<component>>
  note bottom of Autenticación_y_permisos
    api/deps: current_actor,
    require_roles, current_device
  end note
  component "Servicio de cuentas" as Servicio_de_cuentas <<component>>
  note bottom of Servicio_de_cuentas
    services: auth, accounts, admin
  end note
  component "Servicio de emparejamiento" as Servicio_de_emparejamiento <<component>>
  note bottom of Servicio_de_emparejamiento
    services: pairing
  end note
  component "Servicio de registros del visor" as Servicio_de_registros_del_visor <<component>>
  note bottom of Servicio_de_registros_del_visor
    services: records
  end note
  component "Servicio de seguimiento" as Servicio_de_seguimiento <<component>>
  note bottom of Servicio_de_seguimiento
    services: tracking, therapy
  end note
  component "Servicio de análisis" as Servicio_de_análisis <<component>>
  note bottom of Servicio_de_análisis
    services: analysis
  end note
  component "IA (SessionAnalyzer)" as IA__SessionAnalyzer_ <<component>>
  note bottom of IA__SessionAnalyzer_
    app/ai: rules-baseline
  end note
  component "Repositorio identity" as Repositorio_identity <<component>>
  note bottom of Repositorio_identity
    repositories/identity
  end note
  component "Repositorio clinical" as Repositorio_clinical <<component>>
  note bottom of Repositorio_clinical
    repositories/clinical
  end note
  component "ORM y sesión de BD" as ORM_y_sesión_de_BD <<component>>
  note bottom of ORM_y_sesión_de_BD
    app/db: models, session
  end note
  component "Core" as Core <<component>>
  note bottom of Core
    config, errors, security,
    ratelimit, logging, pagination
  end note
}
package "Web NEUROPHOBIA (NP_Front)" <<subsystem>> {
  component "Enrutador" as Enrutador <<component>>
  note bottom of Enrutador
    App.tsx (React Router)
  end note
  component "Contexto de autenticación" as Contexto_de_autenticación <<component>>
  note bottom of Contexto_de_autenticación
    auth: AuthProvider, RequireRole
  end note
  component "Páginas" as Páginas <<component>>
  note bottom of Páginas
    public, patient, professional,
    admin, cuenta, errores
  end note
  component "Componentes de presentación" as Componentes_de_presentación <<component>>
  note bottom of Componentes_de_presentación
    Layout, Clinical, therapy, ui
  end note
  component "Hooks" as Hooks <<component>>
  note bottom of Hooks
    useApi, usePaged
  end note
  component "Cliente de API" as Cliente_de_API <<component>>
  note bottom of Cliente_de_API
    api: client, endpoints, adapters
  end note
  component "Textos i18n" as Textos_i18n <<component>>
  note bottom of Textos_i18n
    es.json
  end note
  component "Simulador MSW" as Simulador_MSW <<component>>
  note bottom of Simulador_MSW
    mocks (solo desarrollo)
  end note
}
package "App VR NEUROPHOBIA (NPdefdef)" <<subsystem>> {
  component "Menú principal" as Menú_principal <<component>>
  note bottom of Menú_principal
    NeuroPhobiaMainMenuModern
  end note
  component "Gestión de sesión" as Gestión_de_sesión <<component>>
  note bottom of Gestión_de_sesión
    SessionManager, LevelManager,
    GameStateManager
  end note
  component "Niveles 1-5" as Niveles_1_5 <<component>>
  note bottom of Niveles_1_5
    controladores por escena
  end note
  component "Métricas" as Métricas <<component>>
  note bottom of Métricas
    MetricsCollector, TaskManager,
    SessionReport, LevelMetrics
  end note
  component "Estímulo (arañas)" as Estímulo__arañas_ <<component>>
  note bottom of Estímulo__arañas_
    AranaController, NPNaturalSpiderPatrol
  end note
  component "UI de sesión" as UI_de_sesión <<component>>
  note bottom of UI_de_sesión
    GlobalSessionUI, BreathingGuide, HUD
  end note
  component "Cliente API Unity" as Cliente_API_Unity <<component>>
  note bottom of Cliente_API_Unity
    FastAPIClient, DeviceRecordMapper
  end note
  component "Bandeja de salida" as Bandeja_de_salida <<component>>
  note bottom of Bandeja_de_salida
    RecordOutbox
  end note
  component "Entrada XR / escritorio" as Entrada_XR___escritorio <<component>>
  note bottom of Entrada_XR___escritorio
    XRBootstrap, ControlModeSelector
  end note
}

Routers_HTTP ..> Autenticación_y_permisos : «use»
Routers_HTTP ..> Servicio_de_cuentas : «use»
Routers_HTTP ..> Servicio_de_emparejamiento : «use»
Routers_HTTP ..> Servicio_de_registros_del_visor : «use»
Routers_HTTP ..> Servicio_de_seguimiento : «use»
Autenticación_y_permisos ..> Repositorio_identity : «use»
Servicio_de_cuentas ..> Repositorio_identity : «use»
Servicio_de_emparejamiento ..> Repositorio_clinical : «use»
Servicio_de_registros_del_visor ..> Servicio_de_análisis : «use»
Servicio_de_registros_del_visor ..> Repositorio_clinical : «use»
Servicio_de_seguimiento ..> Repositorio_clinical : «use»
Servicio_de_análisis ..> IA__SessionAnalyzer_ : «use»
Repositorio_identity ..> ORM_y_sesión_de_BD : «use»
Repositorio_clinical ..> ORM_y_sesión_de_BD : «use»
ORM_y_sesión_de_BD ..> Core : «use»
Enrutador ..> Páginas : «use»
Enrutador ..> Contexto_de_autenticación : «use»
Páginas ..> Componentes_de_presentación : «use»
Páginas ..> Hooks : «use»
Páginas ..> Textos_i18n : «use»
Hooks ..> Cliente_de_API : «use»
Contexto_de_autenticación ..> Cliente_de_API : «use»
Simulador_MSW ..> Cliente_de_API : simula IWebAPI
Menú_principal ..> Gestión_de_sesión : «use»
Menú_principal ..> Cliente_API_Unity : «use»
Niveles_1_5 ..> Gestión_de_sesión : «use»
Niveles_1_5 ..> Métricas : «use»
Niveles_1_5 ..> Estímulo__arañas_ : «use»
Niveles_1_5 ..> UI_de_sesión : «use»
Gestión_de_sesión ..> Cliente_API_Unity : «use»
Cliente_API_Unity ..> Bandeja_de_salida : «use»
Niveles_1_5 ..> Entrada_XR___escritorio : «use»
Cliente_de_API ..> Routers_HTTP : IWebAPI vía proxy
Cliente_API_Unity ..> Routers_HTTP : IDeviceAPI
@enduml
