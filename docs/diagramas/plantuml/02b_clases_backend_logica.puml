@startuml 02b_clases_backend_logica
title NP_Back - Clases (servicios, repositorios, IA y core)
skinparam classAttributeIconSize 0
skinparam linetype ortho
hide empty members

class "AuthService" as AuthService <<service>> {
  --
  + register(data : RegisterIn, ip : str) : UUID
  + login(email : str, password : str, ip : str) : IssuedTokens
  + refresh(token : str) : IssuedTokens
  + logout(token : str) : void
  + create_account(email, password, role, full_name) : UUID
  + ensure_patient_link(user_id : UUID) : UUID
  - _issue(user_id, role, family_id) : IssuedTokens
}
class "AccountsService" as AccountsService <<service>> {
  --
  + get_me(actor : Actor) : MeOut
  + patch_me(actor : Actor, data : MePatch) : MeOut
  + change_password(actor : Actor, current : str, new : str) : void
  + withdraw_consent(actor : Actor) : void
  + change_email(user : User, email : str, now : datetime) : void
}
class "AdminService" as AdminService <<service>> {
  --
  + list_users(page, role, active, q) : AdminUserPage
  + get_user(user_id) : AdminUserOut
  + create_user(data : AdminUserCreate) : AdminUserOut
  + patch_user(user_id, data : AdminUserPatch) : AdminUserOut
  + reset_password(user_id, temporary_password) : void
  + list_assignments(page, professional_id) : AssignmentPage
  + create_assignment(professional_id, patient_id) : AssignmentOut
  + delete_assignment(assignment_id) : void
  + analysis_dataset() : dict
  + dataset_to_csv(dataset : dict) : str
}
class "PairingService" as PairingService <<service>> {
  --
  + create_code(pseudonym : UUID) : PairingCodeOut
  + pair(data : PairIn, ip : str) : PairOut
  + authenticate_device(token : str) : DeviceActor
  + list_devices(pseudonym) : DevicePage
  + revoke_device(pseudonym, device_id) : void
}
class "Actor" as Actor <<dataclass>> {
  + user_id : UUID
  + role : str
}
class "DeviceActor" as DeviceActor <<dataclass>> {
  + device_id : UUID
  + pseudonym_id : UUID
}
class "IssuedTokens" as IssuedTokens <<dataclass>> {
  + access_token : str
  + expires_in : int
  + refresh_token : str
  + user_id : UUID
  + role : str
}
class "PostgresWindowLimiter" as PostgresWindowLimiter {
  --
  + count(key, window) : int
  + hit(key, window)
  + check_and_hit(key, limit, window)
  + ensure_below(key, limit, window)
}
class "TrackingService" as TrackingService <<service>> {
  --
  + own_pseudonym(actor : Actor) : UUID
  + assigned_pseudonym(actor, patient_id) : UUID
  + progress(pseudonym) : ProgressOut
  + list_sessions(pseudonym, page) : SessionPage
  + session_detail(pseudonym, session_id, with_notes) : SessionDetail
  + my_patients(actor, page) : PatientPage
  + set_plan(patient_id, pseudonym, level : int) : PlanOut
  + list_notes(pseudonym, page, session_id) : NotePage
  + add_note(actor, pseudonym, text, session_id) : NoteCreated
  + edit_note(actor, pseudonym, note_id, text) : NoteOut
}
class "TherapyService" as TherapyService <<service>> {
  --
  + set_phobia_grade(pseudonym, grade : int) : PhobiaGradeOut
  + sync_phobia_grade_from_session(pseudonym, grade, at) : void
  + therapy_state(pseudonym) : TherapyStateOut
  + device_session(device, session_id) : DeviceSessionOut
  + feedback_page(pseudonym, page) : FeedbackPage
  + unpair(device : DeviceActor) : void
}
class "RecordsService" as RecordsService <<service>> {
  --
  + ingest(device : DeviceActor, body : dict) : RecordResult
  + parse_envelope(body) : RecordEnvelope
  + content_hash(body : dict) : str
  + device_context(device : DeviceActor) : DeviceContext
  - _store(...) : str
  - _duplicate_or_conflict(...) : str
}
class "AnalysisService" as AnalysisService <<service>> {
  --
  + refresh_analysis(session : TherapySession) : void
  + feedback_for(session : TherapySession) : FeedbackOut
}
class "IdentityRepository" as IdentityRepository <<repository>> {
  --
  + get_user(user_id) : User
  + get_user_by_email(email) : User
  + add_user(...) : User
  + set_full_name(user_id, name)
  + add_consent / withdraw_consents(...)
  + get_pseudonym(user_id) : UUID
  + add_link / delete_link(...)
  + add_assignment / list_assignments(...)
  + is_assigned(prof_id, patient_id) : bool
  + add_refresh_token / revoke_family(...)
}
class "ClinicalRepository" as ClinicalRepository <<repository>> {
  --
  + add_patient() / get_patient(pseudonym_id) : Patient
  + add_pairing_code / get_pairing_code(...)
  + add_device / get_device_by_token_hash(...)
  + try_add_inbound / get_inbound(...)
  + lock_or_create_session(session_id, pseudonym_id)
  + list_sessions / progress_sessions(...)
  + add_level_record / level_records(...)
  + upsert_analysis / analyses_for(...)
  + add_note / list_notes / get_note(...)
  + export_rows(method)
}
class "AnalyzerRegistry" as AnalyzerRegistry <<utility>> {
  --
  + get_analyzer(method : str) : SessionAnalyzer
}
class "FeatureExtractor" as FeatureExtractor <<utility>> {
  --
  + level_features(payload : dict) : LevelFeatures
  + session_features(...) : SessionFeatures
}
class "Settings" as Settings <<BaseSettings>> {
  + database_url : SecretStr
  + secret_key : SecretStr
  + cors_origin : str
  + access_token_minutes : int = 15
  + refresh_token_days : int = 7
  + pairing_code_minutes : int = 10
  + ai_method : str
}
class "ApiError" as ApiError <<Exception>> {
  + status : int
  + code : str
  + detail : str [0..1]
  + errors : list [0..1]
}
interface "SessionAnalyzer" as SessionAnalyzer {
  + method : str
  + method_version : str
  --
  + analyze(features : SessionFeatures) : AnalysisResult [0..1]
}
class "SessionFeatures" as SessionFeatures <<dataclass>> {
  + phobia_grade : int [0..1]
  + level_reached : int [0..1]
  + end_reason : str [0..1]
  + levels : LevelFeatures [*]
}
enum "Recommendation" as Recommendation {
  advance
  repeat
  step_back
}
class "RulesBaselineAnalyzer" as RulesBaselineAnalyzer {
  - config : dict
  --
  + analyze(features : SessionFeatures) : AnalysisResult [0..1]
  - _effect(score : float) : Effect
}
class "LevelFeatures" as LevelFeatures <<dataclass>> {
  + level : int
  + attempt : int
  + outcome : str
  + criterion_met : bool
  + permanence_seconds : float
  + avoidance_count : int
  + min_distance_m : float [0..1]
  + suds_before : int [0..1]
  + suds_after : int [0..1]
  + ended_at_epoch : float
}
enum "Effect" as Effect {
  favorable
  unfavorable
  neutral
}
class "AnalysisResult" as AnalysisResult <<dataclass>> {
  + method : str
  + method_version : str
  + tolerance_index : float
  + recommendation : Recommendation
  + basis : BasisItem [*]
  + clinical_status : str
}
class "BasisItem" as BasisItem <<dataclass>> {
  + feature : str
  + value : float
  + effect : Effect
}

RulesBaselineAnalyzer ..|> SessionAnalyzer
SessionFeatures "1" *-- "0..*" LevelFeatures
AnalysisResult "1" *-- "0..*" BasisItem
AnalysisResult -- Recommendation
BasisItem -- Effect
AnalyzerRegistry ..> SessionAnalyzer : «create»
AnalysisService ..> AnalyzerRegistry : «use»
AnalysisService ..> FeatureExtractor : «use»
AnalysisService ..> ClinicalRepository : «use»
RecordsService ..> AnalysisService : «use»
RecordsService ..> TherapyService : «use»
RecordsService ..> ClinicalRepository : «use»
AuthService ..> IdentityRepository : «use»
AuthService ..> ClinicalRepository : «use»
AuthService ..> PostgresWindowLimiter : «use»
AuthService ..> IssuedTokens : «create»
AccountsService ..> IdentityRepository : «use»
AdminService ..> AuthService : «use»
AdminService ..> AccountsService : «use»
AdminService ..> IdentityRepository : «use»
PairingService ..> ClinicalRepository : «use»
PairingService ..> PostgresWindowLimiter : «use»
PairingService ..> DeviceActor : «create»
TrackingService ..> ClinicalRepository : «use»
TrackingService ..> IdentityRepository : «use»
TherapyService ..> ClinicalRepository : «use»
TrackingService ..> Actor : «use»
AccountsService ..> Actor : «use»
RecordsService ..> DeviceActor : «use»
FeatureExtractor ..> SessionFeatures : «create»
RulesBaselineAnalyzer ..> AnalysisResult : «create»
@enduml
